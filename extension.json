{
	"name": "Mentat",
	"author": [
		"[https://github.com/FlamingMojo FlamingMojo]"
	],
	"url": "https://github.com/flamingmojo/mw-mentat",
	"version": "0.1",
	"descriptionmsg": "mentat-desc",
	"license-name": "MIT",
	"requires": {
		"MediaWiki": ">= 1.40.0"
	},
	"manifest_version": 1,
	"config": {
		"MentatWebhookURL": ["https://mentat.wiki/webhooks/"]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\Mentat\\": "src/"
	},
	"MessagesDirs": {
		"Mentat": "i18n"
	},
	"AutoloadClasses": {
		"MentatHooks": "src/MentatHooks.php",
		"MentatUtils": "src/MentatUtils.php",
		"MentatMessageSender": "src/MentatMessageSender.php"
	},
	"Hooks": {
		"PageSaveComplete": "MentatHooks::onPageSaveComplete",
		"PageDeleteComplete": "MentatHooks::onPageDeleteComplete",
		"ArticleUndelete": "MentatHooks::onArticleUndelete",
		"ArticleRevisionVisibilitySet": "MentatHooks::onArticleRevisionVisibilitySet",
		"ArticleProtectComplete": "MentatHooks::onArticleProtectComplete",
		"PageMoveComplete": "MentatHooks::onPageMoveComplete",
		"LocalUserCreated": "MentatHooks::onLocalUserCreated",
		"BlockIpComplete": "MentatHooks::onBlockIpComplete",
		"UnblockUserComplete": "MentatHooks::onUnblockUserComplete",
		"UserGroupsChanged": "MentatHooks::onUserGroupsChanged",
		"UploadComplete": "MentatHooks::onUploadComplete",
		"FileDeleteComplete": "MentatHooks::onFileDeleteComplete",
		"FileUndeleteComplete": "MentatHooks::onFileUndeleteComplete",
		"AfterImportPage": "MentatHooks::onAfterImportPage",
		"ArticleMergeComplete": "MentatHooks::onArticleMergeComplete",
		"ApprovedRevsRevisionApproved": "MentatHooks::onApprovedRevsRevisionApproved",
		"ApprovedRevsRevisionUnapproved": "MentatHooks::onApprovedRevsRevisionUnapproved",
		"ApprovedRevsFileRevisionApproved": "MentatHooks::onApprovedRevsFileRevisionApproved",
		"ApprovedRevsFileRevisionUnapproved": "MentatHooks::onApprovedRevsFileRevisionUnapproved",
		"RenameUserComplete": "MentatHooks::onRenameUserComplete"
	}
}
